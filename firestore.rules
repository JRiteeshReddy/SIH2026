rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection (users/{uid})
    match /users/{userId} {
      // Authenticated users can read user profiles (required for leaderboard and social features)
      allow read: if isAuthenticated();

      // Users can create their own initial profile during onboarding/registration
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId;

      // Users can update non-authoritative profile fields (username, college, avatar, cityState, updatedAt)
      // Authoritative progression fields (ecoXP, level, reputation, speciesFound, totalDistance)
      // are protected from direct arbitrary client mutation and should be managed via Cloud Functions / Admin SDK in production.
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ecoXP', 'level', 'reputation', 'speciesFound', 'totalDistance']);

      allow delete: if false;
    }

    // 2. Expeditions collection (expeditions/{expeditionId})
    match /expeditions/{expeditionId} {
      // Users can read their own logged expeditions
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Users can log their own expeditions
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if false;
    }

    // 3. Discoveries collection (discoveries/{discoveryId})
    match /discoveries/{discoveryId} {
      // Authenticated users can read verified wildlife discoveries
      allow read: if isAuthenticated();

      // Users can create discoveries for themselves with strict field validation
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.speciesId is string
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.confidence is number
        && request.resource.data.confidence >= 0
        && request.resource.data.confidence <= 1
        && request.resource.data.timestamp is string;

      allow update, delete: if false;
    }

    // 4. Conservation Reports collection (reports/{reportId})
    match /reports/{reportId} {
      // Users can only submit reports as themselves
      allow create: if isAuthenticated()
        && request.resource.data.reporterUserId == request.auth.uid;

      allow read, update, delete: if false;
    }
  }
}
